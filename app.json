{
  "expo": {
    "name": "HODIX",
    "slug": "hodix",
    "owner": "hodixs-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hodix",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F2847",
    "description": "Épargne communautaire africaine : tontines, wallet Mobile Money, trust score et paiements sécurisés.",
    "privacy": "https://www.hodix.app/privacy",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000",
      "translucent": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hodix.mobile",
      "associatedDomains": [
        "applinks:www.hodix.app",
        "applinks:hodix.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.hodix.mobile",
      "versionCode": 1,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=app.hodix.mobile",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.hodix.app",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "hodix.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "HODIX – Épargne & Tontines",
      "shortName": "HODIX",
      "description": "Plateforme africaine de finance participative. Gérez vos tontines, épargnez en groupe et payez en toute sécurité.",
      "themeColor": "#0F2847",
      "backgroundColor": "#F8FAFC",
      "lang": "fr",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HODIX utilise Face ID pour sécuriser l'accès à votre compte et confirmer vos transactions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HODIX a besoin d'accéder à vos photos pour téléverser vos documents KYC et justificatifs."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false
          },
          "ios": {
            "deploymentTarget": "13.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "452e134d-362a-4310-8e56-7c2087298d2b"
      },
      "router": {
        "origin": false
      },
      "privacyPolicyUrl": "https://www.hodix.app/privacy",
      "termsUrl": "https://www.hodix.app/cgu",
      "supportEmail": "support@hodix.app",
      "dpoEmail": "privacy@hodix.app",
      "accountDeletionUrl": "https://www.hodix.app/data-rights"
    }
  }
}
